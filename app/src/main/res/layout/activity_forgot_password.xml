<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_light" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="28dp">

        <!-- Back button -->
        <Button
            android:id="@+id/btnForgotBack"
            android:layout_width="48dp" android:layout_height="48dp"
            android:text="←" android:textSize="20sp"
            android:textColor="@color/blue_dark"
            android:background="@drawable/feature_card_bg"
            android:stateListAnimator="@null"/>

        <TextView
            android:id="@+id/tvForgotTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Quên mật khẩu"
            android:textSize="28sp" android:textStyle="bold"
            android:textColor="@color/blue_dark"
            android:layout_marginTop="24dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Nhập email để khôi phục tài khoản"
            android:textSize="14sp" android:textColor="#5A6A85"
            android:layout_marginTop="8dp" android:layout_marginBottom="36dp"/>

        <!-- STEP 1: Nhập email -->
        <LinearLayout android:id="@+id/layoutStep1"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="visible">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Email đã đăng ký" android:textSize="13sp"
                android:textColor="@color/blue_dark" android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText android:id="@+id/etForgotEmail"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:hint="Nhập email của bạn"
                android:inputType="textEmailAddress"
                android:background="@drawable/input_bg"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:textColor="@color/blue_dark" android:textColorHint="#AABBD0"
                android:layout_marginBottom="24dp"/>

            <Button android:id="@+id/btnCheckEmail"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:text="Xác nhận email" android:textSize="16sp"
                android:textStyle="bold" android:textColor="@android:color/white"
                android:background="@drawable/btn_primary_bg"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- STEP 2: Đặt mật khẩu mới -->
        <LinearLayout android:id="@+id/layoutStep2"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Mật khẩu mới" android:textSize="13sp"
                android:textColor="@color/blue_dark" android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText android:id="@+id/etNewPassword"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:hint="Nhập mật khẩu mới"
                android:inputType="textPassword"
                android:background="@drawable/input_bg"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:textColor="@color/blue_dark" android:textColorHint="#AABBD0"
                android:layout_marginBottom="16dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Xác nhận mật khẩu mới" android:textSize="13sp"
                android:textColor="@color/blue_dark" android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText android:id="@+id/etConfirmNewPassword"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:hint="Nhập lại mật khẩu mới"
                android:inputType="textPassword"
                android:background="@drawable/input_bg"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:textColor="@color/blue_dark" android:textColorHint="#AABBD0"
                android:layout_marginBottom="24dp"/>

            <Button android:id="@+id/btnResetPass"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:text="Đặt lại mật khẩu" android:textSize="16sp"
                android:textStyle="bold" android:textColor="@android:color/white"
                android:background="@drawable/btn_primary_bg"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>