<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="700dp">

        <View
            android:id="@+id/headerBg"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/header_wave_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Home"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:layout_constraintTop_toTopOf="@id/headerBg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="52dp"/>

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Điều khiển ngôi nhà thông minh"
            android:textSize="14sp"
            android:textColor="#DDEEFF"
            app:layout_constraintTop_toBottomOf="@id/tvAppName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardAuth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@android:color/white"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toTopOf="@id/headerBg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="160dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- Tab -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:background="@drawable/tab_container_bg"
                    android:padding="4dp">

                    <Button
                        android:id="@+id/btnTabLogin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Log In"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/tab_active_bg"
                        android:textColor="@android:color/white"
                        android:stateListAnimator="@null"/>

                    <Button
                        android:id="@+id/btnTabSignIn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Sign In"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@android:color/transparent"
                        android:textColor="@color/blue_primary"
                        android:stateListAnimator="@null"/>
                </LinearLayout>

                <!-- LOGIN -->
                <LinearLayout
                    android:id="@+id/layoutLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="24dp"
                    android:visibility="visible">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Email hoặc Tên đăng nhập" android:textSize="13sp"
                        android:textColor="@color/blue_dark" android:textStyle="bold" android:layout_marginBottom="8dp"/>

                    <EditText
                        android:id="@+id/etLoginEmail"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:hint="Nhập email hoặc tên đăng nhập"
                        android:inputType="textEmailAddress"
                        android:background="@drawable/tab_container_bg"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:textColor="@color/blue_dark" android:textColorHint="#AABBD0"
                        android:layout_marginBottom="16dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Mật khẩu" android:textSize="13sp"
                        android:textColor="@color/blue_dark" android:textStyle="bold" android:layout_marginBottom="8dp"/>

                    <EditText
                        android:id="@+id/etLoginPassword"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:hint="Nhập mật khẩu"
                        android:inputType="textPassword"
                        android:background="@drawable/tab_container_bg"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:textColor="@color/blue_dark" android:textColorHint="#AABBD0"
                        android:layout_marginBottom="24dp"/>

                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent" android:layout_height="54dp"
                        android:text="Đăng Nhập" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:background="@drawable/btn_primary_bg"
                        android:stateListAnimator="@null"/>

                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quên mật khẩu?"
                        android:textSize="13sp"
                        android:textColor="@color/blue_primary"
                        android:textStyle="bold"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:padding="8dp"/>

                </LinearLayout>

                <!-- SIGN IN -->
                <LinearLayout
                    android:id="@+id/layoutSignIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="24dp"
                    android:visibility="gone">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Email hoặc Tên đăng nhập" android:textSize="13sp"
                        android:textColor="@color/blue_dark" android:textStyle="bold" android:layout_marginBottom="8dp"/>

                    <EditText
                        android:id="@+id/etSignInEmail"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:hint="Nhập email hoặc tên đăng nhập"
                        android:inputType="textEmailAddress"
                        android:background="@drawable/tab_container_bg"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:textColor="@color/blue_dark" android:textColorHint="#AABBD0"
                        android:layout_marginBottom="16dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Mật khẩu" android:textSize="13sp"
                        android:textColor="@color/blue_dark" android:textStyle="bold" android:layout_marginBottom="8dp"/>

                    <EditText
                        android:id="@+id/etSignInPassword"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:hint="Nhập mật khẩu"
                        android:inputType="textPassword"
                        android:background="@drawable/tab_container_bg"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:textColor="@color/blue_dark" android:textColorHint="#AABBD0"
                        android:layout_marginBottom="16dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Xác nhận mật khẩu" android:textSize="13sp"
                        android:textColor="@color/blue_dark" android:textStyle="bold" android:layout_marginBottom="8dp"/>

                    <EditText
                        android:id="@+id/etSignInConfirmPassword"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:hint="Nhập lại mật khẩu"
                        android:inputType="textPassword"
                        android:background="@drawable/tab_container_bg"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:textColor="@color/blue_dark" android:textColorHint="#AABBD0"
                        android:layout_marginBottom="24dp"/>

                    <Button
                        android:id="@+id/btnSignIn"
                        android:layout_width="match_parent" android:layout_height="54dp"
                        android:text="Đăng Ký" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:background="@drawable/btn_primary_bg"
                        android:stateListAnimator="@null"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Chính sách bảo mật · Điều khoản dịch vụ"
                    android:textSize="11sp" android:textColor="#AABBD0"
                    android:gravity="center" android:layout_marginTop="16dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>