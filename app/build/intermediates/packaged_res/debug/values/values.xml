<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg_light">#F0F5FB</color>
    <color name="blue_dark">#1A3A5C</color>
    <color name="blue_indicator">#DCE9FF</color>
    <color name="blue_light">#B8D4EE</color>
    <color name="blue_primary">#5B9BD5</color>
    <string name="app_name">SmartHomeApp</string>
    <style name="BottomNavStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@android:color/white</item>
        <item name="itemIconSize">26dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemHorizontalTranslationEnabled">false</item>
    </style>
    <style name="Theme.SmartHome" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryVariant">@color/blue_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:statusBarColor">@color/blue_dark</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="bottomNavigationStyle">@style/BottomNavStyle</item>
    </style>
</resources>